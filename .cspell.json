{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en,en-GB",
  "caseSensitive": false,
  "allowCompoundWords": false,
  "dictionaryDefinitions": [
    {
      "name": "intellicrack",
      "path": ".cspell/project-words.txt",
      "description": "Intellicrack, its bridged tools, and the formats it reads.",
      "addWords": true
    }
  ],
  "dictionaries": [
    "intellicrack",
    "aws",
    "bash",
    "companies",
    "computing-acronyms",
    "cpp",
    "cpp-legacy",
    "cryptocurrencies",
    "css",
    "data-science",
    "docker",
    "dotnet",
    "en_us",
    "en-gb",
    "filetypes",
    "fonts",
    "fullstack",
    "git",
    "golang",
    "google",
    "html",
    "html-symbol-entities",
    "java",
    "k8s",
    "makefile",
    "networking-terms",
    "node",
    "npm",
    "posix-errno",
    "posix-signals",
    "powershell",
    "public-licenses",
    "python",
    "python-common",
    "rust",
    "rust-crates",
    "shellscript",
    "software-terms-alternative",
    "software-tools",
    "softwareTerms",
    "sql",
    "typescript",
    "web-services",
    "zig"
  ],
  "ignorePaths": [
    "**/.claude/**",
    "**/.git/**",
    "**/.pixi/**",
    "**/__pycache__/**",
    "**/build/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/reports/**",
    "**/target/**",
    "**/tools/**",
    "**/vendor/**",
    ".cspell/project-words.txt",
    ".cspell.json"
  ]
}
