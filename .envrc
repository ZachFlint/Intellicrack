# Automatic pixi environment activation with direnv.
# Install: https://direnv.net/  (see pixi docs: Integration > direnv)
#
# NOTE: This works with direnv under bash / WSL / Linux / CI. On native Windows
# PowerShell the direnv hook currently fails (direnv spawns Git-bash to evaluate
# this file and cannot re-exec its own Windows-path binary, exit 127); use the
# PowerShell-profile pixi activation on Windows instead.

watch_file pixi.toml
watch_file pixi.lock

# Install (if needed) and activate the pixi environment.
eval "$(pixi shell-hook)"

export RUSTUP_TOOLCHAIN=""
export PIXI_PROJECT_ROOT="$(pwd)"

# Force UV (used by pixi) to use the pixi environment Python, not system Python.
export UV_PYTHON="$(pwd)/.pixi/envs/default/python.exe"
export UV_PYTHON_PREFERENCE="only-system"
