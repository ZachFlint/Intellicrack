      <data key="d3">src.intellicrack.ui.panels.x64dbg_panel</data>
      <data key="d4">X64dbg debugger panel for Intellicrack.

Provides disassembly, register inspection, breakpoint management, memory viewing, stack traces, and command console for interactive
debugging via the X64DbgBridge backend.</data>
    </node>
    <node id="intellicrack.ui.win32_embed" />
