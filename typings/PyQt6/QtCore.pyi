import enum
import typing

import PyQt6.sip

class pyqtSignal:
    signatures: tuple[str, ...]
    def __init__(self, *types: type, name: str = ...) -> None: ...
    @typing.overload
    def __get__(self, instance: None, owner: type[QObject]) -> pyqtSignal: ...
    @typing.overload
    def __get__(self, instance: QObject, owner: type[QObject]) -> pyqtBoundSignal: ...

class pyqtBoundSignal:
    signal: str
    def __getitem__(self, key: object) -> pyqtBoundSignal: ...
    def connect(self, slot: typing.Callable[..., object] | pyqtBoundSignal) -> QMetaObject.Connection: ...
    @typing.overload
    def disconnect(self) -> None: ...
    @typing.overload
    def disconnect(
        self, slot: typing.Callable[..., object] | pyqtBoundSignal | QMetaObject.Connection
    ) -> None: ...
    def emit(self, *args: object) -> None: ...

PYQT_SIGNAL = pyqtSignal | pyqtBoundSignal
PYQT_SLOT = typing.Callable[..., object] | pyqtBoundSignal

_FuncT = typing.TypeVar("_FuncT", bound=typing.Callable[..., object])

def pyqtSlot(*types: type, name: str | None = ..., result: type | None = ...) -> typing.Callable[[_FuncT], _FuncT]: ...

QObjectT = typing.TypeVar("QObjectT", bound="QObject")

class QObject:
    def __init__(self, parent: QObject | None = ...) -> None: ...
    def objectName(self) -> str: ...
