    def findChild(self, types: tuple[type[QObjectT], ...], name: str = ..., options: Qt.FindChildOption = ...) -> QObjectT | None: ...
    @typing.overload
    def findChildren(self, type: type[QObjectT], name: str = ..., options: Qt.FindChildOption = ...) -> list[QObjectT]: ...
    @typing.overload
    def findChildren(self, types: tuple[type[QObjectT], ...], name: str = ..., options: Qt.FindChildOption = ...) -> list[QObjectT]: ...
    def deleteLater(self) -> None: ...
    def blockSignals(self, block: bool) -> bool: ...
    def signalsBlocked(self) -> bool: ...
    def property(self, name: str) -> typing.Any: ...
    def setProperty(self, name: str, value: typing.Any) -> bool: ...
    def inherits(self, classname: str) -> bool: ...
    def thread(self) -> QThread | None: ...
    def moveToThread(self, thread: QThread | None) -> None: ...
    def isWidgetType(self) -> bool: ...
    def isWindowType(self) -> bool: ...
    def sender(self) -> QObject | None: ...
    destroyed: typing.ClassVar[pyqtSignal]
    objectNameChanged: typing.ClassVar[pyqtSignal]

class QMetaObject:
    class Connection:
        def __init__(self) -> None: ...
        def __bool__(self) -> bool: ...

class QThread(QObject):
    started: typing.ClassVar[pyqtSignal]
    finished: typing.ClassVar[pyqtSignal]
    def __init__(self, parent: QObject | None = ...) -> None: ...
    def run(self) -> None: ...
    def start(self, priority: QThread.Priority = ...) -> None: ...
    def terminate(self) -> None: ...
    def quit(self) -> None: ...
    @typing.overload
    def wait(self, time: int = ...) -> bool: ...
    @typing.overload
    def wait(self, deadline: QDeadlineTimer) -> bool: ...
    def isRunning(self) -> bool: ...
    def isFinished(self) -> bool: ...
    def requestInterruption(self) -> None: ...
    def isInterruptionRequested(self) -> bool: ...
    @staticmethod
    def currentThread() -> QThread: ...
    @staticmethod
    def msleep(msecs: int) -> None: ...
    @staticmethod
    def sleep(secs: int) -> None: ...
    @staticmethod
    def usleep(usecs: int) -> None: ...
    class Priority(enum.Enum):
        IdlePriority = ...
        LowestPriority = ...
        LowPriority = ...
        NormalPriority = ...
        HighPriority = ...
        HighestPriority = ...
        TimeCriticalPriority = ...
        InheritPriority = ...

class QDeadlineTimer:
    def __init__(self, msecs: int = ...) -> None: ...

class QTimer(QObject):
    timeout: typing.ClassVar[pyqtSignal]
    def __init__(self, parent: QObject | None = ...) -> None: ...
    def start(self, msec: int = ...) -> None: ...
    def stop(self) -> None: ...
    def isActive(self) -> bool: ...
    def setInterval(self, msec: int) -> None: ...
    def interval(self) -> int: ...
    def setSingleShot(self, singleShot: bool) -> None: ...
    def isSingleShot(self) -> bool: ...
    def remainingTime(self) -> int: ...
    @typing.overload
    @staticmethod
    def singleShot(msec: int, slot: typing.Callable[..., typing.Any]) -> None: ...
    @typing.overload
    @staticmethod
    def singleShot(msec: int, timerType: Qt.TimerType, slot: typing.Callable[..., typing.Any]) -> None: ...

