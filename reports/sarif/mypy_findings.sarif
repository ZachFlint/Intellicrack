{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "mypy",
          "version": "1.0.0",
          "rules": [
            {
              "id": "no-any-return",
              "shortDescription": {
                "text": "Returning Any from function declared to return \"HexDocument\""
              }
            },
            {
              "id": "has-type",
              "shortDescription": {
                "text": "Cannot determine type of \"_initialized\""
              }
            },
            {
              "id": "unreachable",
              "shortDescription": {
                "text": "Right operand of \"or\" is never evaluated"
              }
            },
            {
              "id": "comparison-overlap",
              "shortDescription": {
                "text": "Non-overlapping equality check (left operand type: \"StyleHint\", right operand type: \"int\")"
              }
            },
            {
              "id": "assignment",
              "shortDescription": {
                "text": "Incompatible types in assignment (expression has type \"RegistryChange\", variable has type \"FileChange\")"
              }
            },
            {
              "id": "typeddict-item",
              "shortDescription": {
                "text": "TypedDict \"FileChange\" has no key \"key\""
              }
            },
            {
              "id": "arg-type",
              "shortDescription": {
                "text": "Argument 1 to \"_scan_text\" has incompatible type \"object\"; expected \"str\""
              }
            },
            {
              "id": "union-attr",
              "shortDescription": {
                "text": "Item \"None\" of \"StreamReader | None\" has no attribute \"readline\""
              }
            },
            {
              "id": "valid-type",
              "shortDescription": {
                "text": "Function \"intellicrack.bridges.process.ProcessBridge.list\" is not valid as a type"
              }
            },
            {
              "id": "general",
              "shortDescription": {
                "text": "Perhaps you need \"Callable[...]\" or a callback protocol?"
              }
            },
            {
              "id": "attr-defined",
              "shortDescription": {
                "text": "\"list?[intellicrack.core.types.ThreadInfo]\" has no attribute \"__iter__\" (not iterable)"
              }
            },
            {
              "id": "var-annotated",
              "shortDescription": {
                "text": "Need type annotation for \"pb\""
              }
            },
            {
              "id": "redundant-cast",
              "shortDescription": {
                "text": "Redundant cast to \"list[Any]\""
              }
            },
            {
              "id": "index",
              "shortDescription": {
                "text": "Value of type \"list?[intellicrack.core.types.ThreadInfo]\" is not indexable"
              }
            },
            {
              "id": "no-untyped-call",
              "shortDescription": {
                "text": "Call to untyped function \"close\" in typed context"
              }
            },
            {
              "id": "func-returns-value",
              "shortDescription": {
                "text": "\"appendPlainText\" of \"QPlainTextEdit\" does not return a value (it only ever returns None)"
              }
            },
            {
              "id": "no-redef",
              "shortDescription": {
                "text": "Name \"data\" already defined on line 2321"
              }
            },
            {
              "id": "name-defined",
              "shortDescription": {
                "text": "Name \"ProcessManager\" is not defined"
              }
            }
          ]
        }
      },
