{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "mypy",
          "version": "1.0.0",
          "rules": [
            {
              "id": "no-any-return",
              "shortDescription": {
                "text": "Returning Any from function declared to return \"HexDocument\""
              }
            },
            {
              "id": "arg-type",
              "shortDescription": {
                "text": "Argument 1 to \"createWindowContainer\" of \"QWidget\" has incompatible type \"object\"; expected \"QWindow | None\""
              }
            },
            {
              "id": "unreachable",
              "shortDescription": {
                "text": "Right operand of \"or\" is never evaluated"
              }
            },
            {
              "id": "assignment",
              "shortDescription": {
                "text": "Incompatible types in assignment (expression has type \"RegistryChange\", variable has type \"FileChange\")"
              }
            },
            {
              "id": "typeddict-item",
              "shortDescription": {
                "text": "TypedDict \"FileChange\" has no key \"key\""
              }
            },
            {
              "id": "has-type",
              "shortDescription": {
                "text": "Cannot determine type of \"_initialized\""
              }
            },
            {
              "id": "attr-defined",
              "shortDescription": {
                "text": "\"type[CFGGraphScene]\" has no attribute \"compute_layers\""
              }
            },
            {
              "id": "union-attr",
              "shortDescription": {
                "text": "Item \"None\" of \"QGraphicsScene | None\" has no attribute \"items\""
              }
            },
            {
              "id": "redundant-cast",
              "shortDescription": {
                "text": "Redundant cast to \"list[Any]\""
              }
            },
            {
              "id": "valid-type",
              "shortDescription": {
                "text": "Function \"r2pipe.open\" is not valid as a type"
              }
            },
            {
              "id": "general",
              "shortDescription": {
                "text": "Perhaps you need \"Callable[...]\" or a callback protocol?"
              }
            },
            {
              "id": "comparison-overlap",
              "shortDescription": {
                "text": "Non-overlapping equality check (left operand type: \"StyleHint\", right operand type: \"int\")"
              }
            },
            {
              "id": "name-defined",
              "shortDescription": {
                "text": "Name \"cast\" is not defined"
              }
            },
            {
              "id": "func-returns-value",
              "shortDescription": {
                "text": "\"appendPlainText\" of \"QPlainTextEdit\" does not return a value (it only ever returns None)"
              }
            },
            {
              "id": "no-redef",
              "shortDescription": {
                "text": "Name \"data\" already defined on line 2251"
              }
            },
            {
              "id": "misc",
              "shortDescription": {
                "text": "Property \"connected\" defined in \"RFBClient\" is read-only"
              }
            },
            {
              "id": "call-arg",
              "shortDescription": {
                "text": "Unexpected keyword argument \"timeout\" for \"connect\" of \"RFBClient\""
              }
            }
          ]
        }
      },
