{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "mypy",
          "version": "1.0.0",
          "rules": [
            {
              "id": "override",
              "shortDescription": {
                "text": "Argument 1 of \"highlightBlock\" is incompatible with supertype \"PyQt6.QtGui.QSyntaxHighlighter\"; supertype defines the argument type as \"str | None\""
              }
            },
            {
              "id": "general",
              "shortDescription": {
                "text": "This violates the Liskov substitution principle"
              }
            },
            {
              "id": "attr-defined",
              "shortDescription": {
                "text": "\"CredentialLoader\" has no attribute \"get_env_var\"; maybe \"set_env_var\" or \"_env_vars\"?"
              }
            },
            {
              "id": "no-untyped-def",
              "shortDescription": {
                "text": "Function is missing a type annotation for one or more arguments"
              }
            },
            {
              "id": "no-any-return",
              "shortDescription": {
                "text": "Returning Any from function declared to return \"dict[str, Any]\""
              }
            },
            {
              "id": "call-overload",
              "shortDescription": {
                "text": "No overload variant of \"QSplitter\" matches argument type \"int\""
              }
            },
            {
              "id": "union-attr",
              "shortDescription": {
                "text": "Item \"None\" of \"QHeaderView | None\" has no attribute \"setVisible\""
              }
            },
            {
              "id": "arg-type",
              "shortDescription": {
                "text": "Argument 1 to \"setTextInteractionFlags\" of \"QLabel\" has incompatible type \"int\"; expected \"TextInteractionFlag\""
              }
            },
            {
              "id": "assignment",
              "shortDescription": {
                "text": "Incompatible types in assignment (expression has type \"None\", variable has type Module)"
              }
            },
            {
              "id": "unreachable",
              "shortDescription": {
                "text": "Statement is unreachable"
              }
            },
            {
              "id": "redundant-cast",
              "shortDescription": {
                "text": "Redundant cast to \"list[Any]\""
              }
            },
            {
              "id": "valid-type",
              "shortDescription": {
                "text": "Function \"r2pipe.open\" is not valid as a type"
              }
            },
            {
              "id": "func-returns-value",
              "shortDescription": {
                "text": "Function does not return a value (it only ever returns None)"
              }
            },
            {
              "id": "comparison-overlap",
              "shortDescription": {
                "text": "Non-overlapping equality check (left operand type: \"StyleHint\", right operand type: \"int\")"
              }
            },
            {
              "id": "name-defined",
              "shortDescription": {
                "text": "Name \"_PROC_COL_COUNT\" is not defined"
              }
            },
            {
              "id": "return-value",
              "shortDescription": {
                "text": "Incompatible return value type (got \"tuple[str, object, str]\", expected \"tuple[str, str, str] | None\")"
              }
            },
            {
              "id": "index",
              "shortDescription": {
                "text": "Value of type \"WatchpointInfo\" is not indexable"
              }
            },
            {
              "id": "method-assign",
              "shortDescription": {
                "text": "Cannot assign to a method"
              }
            },
            {
              "id": "call-arg",
              "shortDescription": {
                "text": "Missing positional argument \"content\" in call to \"set_tab_info\" of \"ToolOutputPanel\""
              }
            }
          ]
        }
      },
