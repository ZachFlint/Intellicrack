{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "mypy",
          "version": "1.0.0",
          "rules": [
            {
              "id": "unreachable",
              "shortDescription": {
                "text": "Right operand of \"or\" is never evaluated"
              }
            },
            {
              "id": "no-any-return",
              "shortDescription": {
                "text": "Returning Any from function declared to return \"HexDocument\""
              }
            },
            {
              "id": "redundant-cast",
              "shortDescription": {
                "text": "Redundant cast to \"dict[str, str]\""
              }
            },
            {
              "id": "attr-defined",
              "shortDescription": {
                "text": "\"Config\" has no attribute \"to_dict\"; maybe \"_to_dict\"?"
              }
            },
            {
              "id": "has-type",
              "shortDescription": {
                "text": "Cannot determine type of \"_initialized\""
              }
            },
            {
              "id": "arg-type",
              "shortDescription": {
                "text": "Argument \"byteorder\" to \"from_bytes\" of \"int\" has incompatible type \"str\"; expected \"Literal['little', 'big']\""
              }
            },
            {
              "id": "assignment",
              "shortDescription": {
                "text": "Incompatible types in assignment (expression has type \"RegistryChange\", variable has type \"FileChange\")"
              }
            },
            {
              "id": "typeddict-item",
              "shortDescription": {
                "text": "TypedDict \"FileChange\" has no key \"key\""
              }
            },
            {
              "id": "call-arg",
              "shortDescription": {
                "text": "Unexpected keyword argument \"timeout\" for \"run_tracked_async\" of \"ProcessManager\""
              }
            },
            {
              "id": "general",
              "shortDescription": {
                "text": "\"run_tracked_async\" defined in \"intellicrack.core.process_manager\""
              }
            },
            {
              "id": "union-attr",
              "shortDescription": {
                "text": "Item \"None\" of \"StreamReader | None\" has no attribute \"readline\""
              }
            },
            {
              "id": "valid-type",
              "shortDescription": {
                "text": "Function \"r2pipe.open\" is not valid as a type"
              }
            },
            {
              "id": "override",
              "shortDescription": {
                "text": "Signature of \"chat\" incompatible with supertype \"intellicrack.providers.base.LLMProviderBase\""
              }
            },
            {
              "id": "ToolCall] | None]",
              "shortDescription": {
                "text": "def chat(self, messages: list[Message], model: str, tools: list[ToolDefinition] | None = ..., temperature: float = ..., max_tokens: int = ..., tool_choice: ToolChoice | None = ..., thinking: ThinkingConfig | None = ..., *, enable_cache: bool = ...) -> Coroutine[Any, Any, tuple[Message, list"
              }
            },
            {
              "id": "str",
              "shortDescription": {
                "text": "def chat_stream(self, messages: list[Message], model: str, tools: list[ToolDefinition] | None = ..., temperature: float = ..., max_tokens: int = ..., tool_choice: ToolChoice | None = ..., thinking: ThinkingConfig | None = ..., *, enable_cache: bool = ...) -> AsyncIterator"
              }
            },
            {
              "id": "operator",
              "shortDescription": {
                "text": "Unsupported operand types for > (\"str\" and \"int\")"
              }
            },
            {
              "id": "index",
              "shortDescription": {
                "text": "Value of type \"WatchpointInfo\" is not indexable"
              }
            },
            {
              "id": "no-redef",
              "shortDescription": {
                "text": "Name \"data\" already defined on line 2143"
              }
            },
            {
              "id": "comparison-overlap",
              "shortDescription": {
                "text": "Non-overlapping identity check (left operand type: \"ToolRegistry | None\", right operand type: \"_MinimalRegistry\")"
              }
            },
            {
              "id": "func-returns-value",
              "shortDescription": {
                "text": "\"appendPlainText\" of \"QPlainTextEdit\" does not return a value (it only ever returns None)"
              }
            },
            {
              "id": "call-overload",
              "shortDescription": {
                "text": "No overload variant of \"itemAt\" of \"QTreeWidget\" matches argument type \"object\""
              }
            },
            {
              "id": "misc",
              "shortDescription": {
                "text": "Property \"connected\" defined in \"RFBClient\" is read-only"
              }
            }
          ]
        }
      },
