            {
              "id": "DOC203",
              "shortDescription": {
                "text": "Function `__getattr__` return type(s) in docstring not consistent with the return annotation. Return annotation types: ['object']; docstring return section types: ['']"
              }
            },
            {
              "id": "DOC602",
              "shortDescription": {
                "text": "Class `ToolBridgeBase`: Class docstring contains more class attributes than in actual class attributes.  (Please read https://jsh9.github.io/pydoclint/checking_class_attributes.html on how to correctly document class attributes.)"
              }
            },
            {
              "id": "DOC603",
              "shortDescription": {
                "text": "Class `ToolBridgeBase`: Class docstring attributes are different from actual class attributes. (Or could be other formatting issues: https://jsh9.github.io/pydoclint/violation_codes.html#notes-on-doc103 ). Arguments in the docstring but not in the actual class attributes: [_capabilities: , _logger: , _state: ]. (Please read https://jsh9.github.io/pydoclint/checking_class_attributes.html on how to correctly document class attributes.)"
              }
            },
            {
              "id": "DOC301",
              "shortDescription": {
                "text": "Class `ToolBridgeBase`: __init__() should not have a docstring; please combine it with the docstring of the class"
              }
            },
            {
              "id": "DOC201",
              "shortDescription": {
                "text": "Method `ToolBridgeBase.is_available` does not have a return section in docstring"
              }
            },
            {
              "id": "DOC101",
              "shortDescription": {
                "text": "Method `ToolInstaller.__init__`: Docstring contains fewer arguments than in function signature."
              }
            },
            {
              "id": "DOC103",
              "shortDescription": {
                "text": "Method `ToolInstaller.__init__`: Docstring arguments are different from function arguments. (Or could be other formatting issues: https://jsh9.github.io/pydoclint/violation_codes.html#notes-on-doc103 ). Arguments in the function signature but not in the docstring: [tools_directory: Path]."
              }
            },
            {
              "id": "DOC601",
              "shortDescription": {
                "text": "Class `ProcessBridge`: Class docstring contains fewer class attributes than actual class attributes.  (Please read https://jsh9.github.io/pydoclint/checking_class_attributes.html on how to correctly document class attributes.)"
              }
            },
            {
              "id": "DOC503",
              "shortDescription": {
                "text": "Method `Orchestrator._run_agent_loop` exceptions in the \"Raises\" section in the docstring do not match those in the function body. Raised exceptions in the docstring: ['CancelledError', 'RuntimeError']. Raised exceptions in the body: ['RuntimeError', 'asyncio.CancelledError']."
              }
            },
            {
              "id": "DOC604",
              "shortDescription": {
                "text": "Class `Session`: Attributes are the same in docstring and class def, but are in a different order.  (Please read https://jsh9.github.io/pydoclint/checking_class_attributes.html on how to correctly document class attributes.)"
              }
            },
            {
              "id": "DOC605",
              "shortDescription": {
                "text": "Class `Session`: Attribute names match, but type hints in these attributes do not match: id, name, created_at, updated_at, provider, model, binaries, active_binary_index, messages, tool_states, patches, licensing_analyses, notes, tags  (Please read https://jsh9.github.io/pydoclint/checking_class_attributes.html on how to correctly document class attributes.)"
              }
            },
            {
              "id": "DOC404",
              "shortDescription": {
                "text": "Method `SessionStore._connection` yield type(s) in docstring not consistent with the return annotation. The yield type (the 0th arg in Generator[...]/Iterator[...]): sqlite3.Connection; docstring \"yields\" section types:"
              }
            }
          ]
        }
