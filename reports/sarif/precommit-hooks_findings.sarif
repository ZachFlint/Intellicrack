  "runs": [
    {
      "tool": {
        "driver": {
          "name": "precommit-hooks",
          "version": "1.0.0",
          "rules": [
            {
              "id": "trailing-whitespace",
              "shortDescription": {
                "text": "[FIXED] Fixed"
              }
            },
            {
              "id": "mixed-line-ending",
              "shortDescription": {
                "text": "[FIXED] fixed mixed line endings"
              }
            },
            {
              "id": "end-of-file-fixer",
              "shortDescription": {
                "text": "[FIXED] Fixed"
              }
            },
            {
              "id": "check-json",
              "shortDescription": {
                "text": "Failed to json decode (Extra data: line 2 column 1 (char 932))"
              }
            }
          ]
        }
      },
