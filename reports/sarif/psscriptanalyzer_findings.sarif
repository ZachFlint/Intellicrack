{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "psscriptanalyzer",
          "version": "1.0.0",
          "rules": [
            {
              "id": "PSAvoidUsingInvokeExpression",
              "shortDescription": {
                "text": "Invoke-Expression is used. Please remove Invoke-Expression from script and find other options instead."
              }
            },
            {
              "id": "PSAvoidUsingWriteHost",
              "shortDescription": {
                "text": "File 'clean.ps1' uses Write-Host. Avoid using Write-Host because it might not work in all hosts, does not work when there is no host, and (prior to PS 5.0) cannot be suppressed, captured, or redirected. Instead, use Write-Output, Write-Verbose, or Write-Information."
              }
            },
            {
              "id": "PSAvoidOverwritingBuiltInCmdlets",
              "shortDescription": {
                "text": "'Write-Progress' is a cmdlet that is included with PowerShell (version core-6.1.0-windows) whose definition should not be overridden"
              }
            },
            {
              "id": "PSUseDeclaredVarsMoreThanAssignments",
              "shortDescription": {
                "text": "The variable 'output' is assigned but never used."
              }
            },
            {
              "id": "PSReviewUnusedParameter",
              "shortDescription": {
                "text": "The parameter 'Flags' has been declared but not used."
              }
            },
            {
              "id": "PSAvoidUsingEmptyCatchBlock",
              "shortDescription": {
                "text": "Empty catch block is used. Please use Write-Error or throw statements in catch blocks."
              }
            },
            {
              "id": "PSAvoidAssignmentToAutomaticVariable",
              "shortDescription": {
                "text": "The Variable 'event' is an automatic variable that is built into PowerShell, assigning to it might have undesired side effects. If assignment is not by design, please use a different name."
              }
            },
            {
              "id": "PSUseApprovedVerbs",
              "shortDescription": {
                "text": "The cmdlet 'Download-File' uses an unapproved verb."
              }
            }
          ]
        }
      },
      "results": [
        {
