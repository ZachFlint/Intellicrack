{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "psscriptanalyzer",
          "version": "1.0.0",
          "rules": [
            {
              "id": "PSAvoidUsingEmptyCatchBlock",
              "shortDescription": {
                "text": "Empty catch block is used. Please use Write-Error or throw statements in catch blocks."
              }
            },
            {
              "id": "PSAvoidUsingWriteHost",
              "shortDescription": {
                "text": "File 'UpdateTools.ps1' uses Write-Host. Avoid using Write-Host because it might not work in all hosts, does not work when there is no host, and (prior to PS 5.0) cannot be suppressed, captured, or redirected. Instead, use Write-Output, Write-Verbose, or Write-Information."
              }
            },
            {
              "id": "PSUseApprovedVerbs",
              "shortDescription": {
                "text": "The cmdlet 'Download-File' uses an unapproved verb."
              }
            },
            {
              "id": "PSAvoidTrailingWhitespace",
              "shortDescription": {
                "text": "Line has trailing whitespace"
              }
            },
            {
              "id": "PSAvoidUsingCmdletAliases",
              "shortDescription": {
                "text": "'sleep' is an alias of 'Start-Sleep'. Alias can introduce possible problems and make scripts hard to maintain. Please consider changing alias to its full content."
              }
            },
            {
              "id": "PSUseSingularNouns",
              "shortDescription": {
                "text": "The cmdlet 'Add-Gdb-Init-Args' uses a plural noun. A singular noun should be used instead."
              }
            },
            {
              "id": "PSReviewUnusedParameter",
              "shortDescription": {
                "text": "The parameter 'ArgList' has been declared but not used."
              }
            }
          ]
        }
      },
      "results": [
        {
