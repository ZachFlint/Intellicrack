          "level": "error",
          "message": {
            "text": "`get_logger()` must be called with `__name__` so the logger participates in the hierarchy `intellicrack.<subpackage>.<module>`. Passing a hand-written literal string (e.g. `get_logger(\"mybridge\")`) breaks parent-child log-level propagation and makes per-module filtering"
          },
          "locations": [
