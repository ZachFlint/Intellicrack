{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "semgrep",
          "version": "1.0.0",
          "rules": [
            {
              "id": "intellicrack-logging-c4-redundant-error-on-exception",
              "shortDescription": {
                "text": "`_logger.exception(...)` already attaches the active traceback via `exc_info=True`. Passing `error=str(e)` duplicates that information and hides the type/traceback under a truncated string."
              }
            },
            {
              "id": "intellicrack-logging-d6-bridge-method-no-entry-log",
              "shortDescription": {
                "text": "A public method on a Bridge class has no log call at all. Every bridge method crosses the boundary"
              }
            },
            {
              "id": "intellicrack-logging-h3-state-assignment-without-log",
              "shortDescription": {
                "text": "A state-tracking attribute (`self._state`, `self._status`, `self._phase`, `self.state`, `self.status`, `self.phase`, `self._active`, `self._connected`, `self._attached`) is being"
              }
            },
            {
              "id": "intellicrack-logging-i8-sandbox-lifecycle-without-log",
              "shortDescription": {
                "text": "@abstractmethod"
              }
            },
            {
              "id": "intellicrack-logging-a3-get-logger-requires-dunder-name",
              "shortDescription": {
                "text": "`get_logger()` must be called with `__name__` so the logger participates in the hierarchy `intellicrack.<subpackage>.<module>`. Passing a hand-written literal string (e.g. `get_logger(\"mybridge\")`) breaks parent-child log-level propagation and makes per-module filtering"
              }
            },
            {
              "id": "intellicrack-logging-h5-init-without-completion-log",
              "shortDescription": {
                "text": "A `__init__` that performs non-trivial work (acquires connections, loads resources, spawns threads) `__init__`."
              }
            },
            {
              "id": "intellicrack-logging-e2-debug-inside-except",
              "shortDescription": {
                "text": "`_logger.debug(...)` inside an `except:` block hides failures below the default log level. In"
              }
            },
            {
              "id": "intellicrack-logging-d5-raise-without-preceding-log",
              "shortDescription": {
                "text": "`raise SomeError(...)` is invoked without any preceding log call in the same function. The stack `_logger.error` or `_logger.warning` with structured kwargs immediately before the raise, or raise"
              }
            },
            {
              "id": "intellicrack-logging-e6-debug-on-destructive-op",
              "shortDescription": {
                "text": "`_logger.debug(...)` on an event name that describes a destructive or state-changing operation"
              }
            },
            {
              "id": "intellicrack-logging-c5-exception-call-outside-except",
              "shortDescription": {
                "text": "`_logger.exception(...)` captures the active exception via `exc_info=True`. When called outside an `except:` block there is no active exception, so it logs `NoneType: None` or nothing at all - a `_logger.error(\"event_name\", error=str(e), error_type=type(e).__name__)`."
              }
            },
            {
              "id": "intellicrack-logging-d1-silent-except-block",
              "shortDescription": {
                "text": "`except:` block contains no log call. Silently swallowing exceptions hides failures from the"
              }
            },
            {
              "id": "intellicrack-logging-d4-except-returns-silent",
              "shortDescription": {
                "text": "`except:` block returns without logging. The caller sees a normal (possibly falsy) return value and"
              }
            },
            {
              "id": "intellicrack-logging-b9-event-name-redundant-with-level",
              "shortDescription": {
                "text": "The event name starts with the level word (`error_...`, `warning_...`, `debug_...`). The level is `_logger.error(\"attach_failed\", ...)` not `_logger.error(\"error_attach_failed\", ...)`."
              }
            },
            {
              "id": "intellicrack-logging-b7-no-dynamic-event-name",
              "shortDescription": {
                "text": "The event name is a variable or expression rather than a string literal. Log aggregators index and"
              }
            },
            {
              "id": "intellicrack-logging-c3-reserved-logrecord-key",
              "shortDescription": {
                "text": "The kwarg name collides with a reserved LogRecord attribute (`name`, `message`, `msg`, `levelname`, `levelno`, `pathname`, `filename`, `module`, `lineno`, `funcName`, `created`, `msecs`, `relativeCreated`, `thread`, `threadName`, `processName`, `process`, `args`, or `asctime`). `stack_info` are excluded because they are documented stdlib-logging kwargs consumed by the handler,"
              }
            },
            {
              "id": "intellicrack-logging-b8-no-format-markers-in-event-name",
              "shortDescription": {
                "text": "The event name contains format markers (`{...}`, `%s`, `%d`) that are not substituted anywhere. `_logger.info(\"memory_write\", address=hex(addr), size=n)`."
              }
            },
            {
              "id": "intellicrack-logging-c1-except-log-missing-error-context",
              "shortDescription": {
                "text": "try:"
              }
            },
            {
              "id": "intellicrack-logging-d8-binary-write-without-log",
              "shortDescription": {
                "text": "script_path.write_text(script_content)"
              }
            },
            {
              "id": "intellicrack-logging-i4-disassembler-call-missing-binary-context",
              "shortDescription": {
                "text": "raw_instructions = disassembler.disassemble(data, offset, arch, mode, count)"
              }
            },
            {
              "id": "intellicrack-logging-g4-fstring-in-kwarg-value",
              "shortDescription": {
                "text": "A kwarg value is an f-string (e.g. `f\"pid={pid} addr={addr}\"`). This re-invents a string-log instead"
              }
            },
            {
              "id": "intellicrack-logging-d3-except-continue",
              "shortDescription": {
                "text": "`except: continue` discards the exception inside a loop with no record of which iteration failed."
              }
            },
            {
              "id": "intellicrack-logging-f5-logging-raw-bytes-payload",
              "shortDescription": {
                "text": "`head_hex=data[:16].hex()`."
              }
            },
            {
              "id": "intellicrack-logging-e7-info-on-error-event",
              "shortDescription": {
                "text": "\"plugin_binaries_missing_attempting_build\","
              }
            },
            {
              "id": "intellicrack-logging-c2-missing-function-context-kwargs",
              "shortDescription": {
                "text": "The enclosing function receives a well-known correlation argument (pid, process_name, binary_path,"
              }
            },
            {
              "id": "intellicrack-logging-d2-except-pass",
              "shortDescription": {
                "text": "`except: pass` is the textbook silent swallow - the exception is caught and discarded with no audit"
              }
            },
            {
              "id": "intellicrack-logging-d14-large-function-zero-logs",
              "shortDescription": {
                "text": "@staticmethod"
              }
            },
            {
              "id": "intellicrack-logging-g5-dynamic-log-level",
              "shortDescription": {
                "text": "`_logger.log(level_variable, ...)` makes the severity unpredictable from static inspection - readers"
              }
            },
            {
              "id": "intellicrack-logging-d9-destructive-op-without-log",
              "shortDescription": {
                "text": "`pathlib.Path.rmdir`). Destructive ops MUST leave an audit trail - confirm a log with the target"
              }
            },
            {
              "id": "intellicrack-logging-g9-kwarg-value-is-empty-collection",
              "shortDescription": {
                "text": "A log kwarg value is a literal empty collection (`[]`, `{}`, `\"\"`, `()`). This adds noise without `matched_rules_count=0` rather than `matched_rules=[]`)."
              }
            },
            {
              "id": "intellicrack-logging-i5-provider-completion-without-model",
              "shortDescription": {
                "text": "def generate(self) -> dict[str, Any]:"
              }
            },
            {
              "id": "intellicrack-logging-b1-no-fstring-event-name",
              "shortDescription": {
                "text": "The first argument to a structlog logger call is the EVENT NAME and must be a constant snake_case `_logger.info(\"process_attached\", pid=pid)`."
              }
            },
            {
              "id": "intellicrack-logging-b5-no-sentence-event-name",
              "shortDescription": {
                "text": "The event name looks like a free-form sentence. Structlog event names must be terse snake_case"
              }
            },
            {
              "id": "intellicrack-logging-d12-async-function-zero-logs",
              "shortDescription": {
                "text": "async def get(self, provider: ProviderName) -> ProviderCredentials | None:"
              }
            },
            {
              "id": "intellicrack-logging-i6-credential-op-missing-key-id",
              "shortDescription": {
                "text": "async def get(self, provider: ProviderName) -> ProviderCredentials | None:"
              }
            },
            {
              "id": "intellicrack-logging-h1-async-def-zero-logs",
              "shortDescription": {
                "text": "`async def` function in a runtime/integration layer (bridges/providers/core/sandbox) contains zero"
              }
            },
            {
              "id": "intellicrack-logging-g1-print-in-src",
              "shortDescription": {
                "text": "`print(...)` writes to stdout/stderr outside the structured logging pipeline. It carries no `_logger.info(\"event_name\", ...)` (or the appropriate level)."
              }
            },
            {
              "id": "intellicrack-logging-a6-logger-must-be-private-module-attr",
              "shortDescription": {
                "text": "logger = get_logger(\"main\")"
              }
            },
            {
              "id": "intellicrack-logging-e1-info-inside-except",
              "shortDescription": {
                "text": "try:"
              }
            },
            {
              "id": "intellicrack-logging-d7-subprocess-without-log",
              "shortDescription": {
                "text": "`os.system`, `os.popen`, `asyncio.create_subprocess_exec`, `asyncio.create_subprocess_shell`) is a"
              }
            },
            {
              "id": "intellicrack-logging-e4-critical-outside-allowlist",
              "shortDescription": {
                "text": "\"unhandled_exception\","
              }
            },
            {
              "id": "intellicrack-logging-e5-warning-announces-success",
              "shortDescription": {
                "text": "\"bridge_event_loop_ready_timeout\","
              }
            }
          ]
        }
      },
