        {
          "ruleId": "intellicrack-logging-c4-redundant-error-on-exception",
          "level": "error",
          "message": {
            "text": "`_logger.exception(...)` already attaches the active traceback via `exc_info=True`. Passing `error=str(e)` duplicates that information and hides the type/traceback under a truncated string."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "D:/Intellicrack/src/intellicrack/main.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 622,
                  "startColumn": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "intellicrack-logging-c5-exception-call-outside-except",
          "level": "error",
          "message": {
            "text": "`_logger.exception(...)` captures the active exception via `exc_info=True`. When called outside an `except:` block there is no active exception, so it logs `NoneType: None` or nothing at all - a `_logger.error(\"event_name\", error=str(e), error_type=type(e).__name__)`."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "D:/Intellicrack/src/intellicrack/main.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 622,
                  "startColumn": 1
                }
              }
            }
          ]
        },
