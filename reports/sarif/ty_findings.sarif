{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ty",
          "version": "1.0.0",
          "rules": [
            {
              "id": "invalid-argument-type",
              "shortDescription": {
                "text": "Argument is incorrect: Expected `Literal[\"ascii\", \"utf-8\", \"utf-16le\", \"utf-16be\"]`, found `str`"
              }
            },
            {
              "id": "unresolved-import",
              "shortDescription": {
                "text": "Cannot resolve imported module `fpdf`"
              }
            },
            {
              "id": "call-non-callable",
              "shortDescription": {
                "text": "Object of type `None` is not callable"
              }
            },
            {
              "id": "invalid-type-form",
              "shortDescription": {
                "text": "Invalid subscript of object of type `def list(self) -> CoroutineType[Any, Any, Unknown]` in a parameter annotation"
              }
            },
            {
              "id": "no-matching-overload",
              "shortDescription": {
                "text": "No overload of bound method `__init__` matches arguments"
              }
            },
            {
              "id": "invalid-assignment",
              "shortDescription": {
                "text": "Object of type `Popen[str] | Popen[bytes] | Popen[Any]` is not assignable to attribute `_process` of type `Popen[bytes] | None`"
              }
            },
            {
              "id": "general",
              "shortDescription": {
                "text": "warning[redundant-cast] Value is already of type `tuple[object, ...]`"
              }
            },
            {
              "id": "call-top-callable",
              "shortDescription": {
                "text": "Object of type `Top[(...) -> object]` is not safe to call; its signature is not known"
              }
            },
            {
              "id": "unresolved-attribute",
              "shortDescription": {
                "text": "Attribute `input` is not defined on `ParsedTextBlock[Any]`, `ThinkingBlock`, `RedactedThinkingBlock`, `WebSearchToolResultBlock` in union `ParsedTextBlock[Any] | ThinkingBlock | RedactedThinkingBlock | ... omitted 3 union elements`"
              }
            },
            {
              "id": "not-subscriptable",
              "shortDescription": {
                "text": "Cannot subscript object of type `None` with no `__getitem__` method"
              }
            },
            {
              "id": "invalid-yield",
              "shortDescription": {
                "text": "Yield type `(str & ~AlwaysFalsy) | (list[str] & ~AlwaysFalsy)` does not match annotated yield type `str`"
              }
            },
            {
              "id": "invalid-method-override",
              "shortDescription": {
                "text": "Invalid override of method `_populate_toolbar`: Definition is incompatible with `AnalysisPanelBase._populate_toolbar`"
              }
            },
            {
              "id": "unsupported-operator",
              "shortDescription": {
                "text": "Operator `>` is not supported between objects of type `int | str | float` and `Literal[0]`"
              }
            },
            {
              "id": "unknown-argument",
              "shortDescription": {
                "text": "Argument `timeout` does not match any known parameter of bound method `run_tracked_async`"
              }
            },
            {
              "id": "not-iterable",
              "shortDescription": {
                "text": "Object of type `~AlwaysFalsy` is not iterable"
              }
            }
          ]
        }
      },
