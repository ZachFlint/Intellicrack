      "tool": {
        "driver": {
          "name": "basedpyright",
          "version": "1.0.0",
          "rules": [
            {
              "id": "reportArgumentType",
              "shortDescription": {
                "text": "Argument of type \"str\" cannot be assigned to parameter \"encoding\" of type \"Literal['ascii', 'utf-8', 'utf-16le', 'utf-16be']\" in function \"__init__\"\n\u00a0\u00a0Type \"str\" is not assignable to type \"Literal['ascii', 'utf-8', 'utf-16le', 'utf-16be']\"\n\u00a0\u00a0\u00a0\u00a0\"str\" is not assignable to type \"Literal['ascii']\"\n\u00a0\u00a0\u00a0\u00a0\"str\" is not assignable to type \"Literal['utf-8']\"\n\u00a0\u00a0\u00a0\u00a0\"str\" is not assignable to type \"Literal['utf-16le']\"\n\u00a0\u00a0\u00a0\u00a0\"str\" is not assignable to type \"Literal['utf-16be']\""
              }
            },
            {
              "id": "reportMissingModuleSource",
              "shortDescription": {
                "text": "Import \"fpdf\" could not be resolved from source"
              }
            },
            {
              "id": "reportUnknownMemberType",
              "shortDescription": {
                "text": "Type of \"parse\" is partially unknown\n\u00a0\u00a0Type of \"parse\" is \"(obj: str | IOBase | PathLike[Unknown] | bytes | list[int]) -> (lief.PE.Binary | lief.OAT.Binary | lief.ELF.Binary | lief.MachO.Binary | lief.COFF.Binary | None)\""
              }
            },
            {
              "id": "reportAttributeAccessIssue",
              "shortDescription": {
                "text": "Cannot access attribute \"_add_toolbar_line_edit\" for class \"CutterPanel*\"\n\u00a0\u00a0Attribute \"_add_toolbar_line_edit\" is unknown"
              }
            },
            {
              "id": "reportUnknownVariableType",
              "shortDescription": {
                "text": "Type of \"addr_text\" is unknown"
              }
            },
            {
              "id": "reportUnknownArgumentType",
              "shortDescription": {
                "text": "Argument type is unknown\n\u00a0\u00a0Argument corresponds to parameter \"x\" in function \"__new__\""
              }
            },
            {
              "id": "reportCallIssue",
              "shortDescription": {
                "text": "No overloads for \"mapToGlobal\" match the provided arguments"
              }
            },
            {
              "id": "reportOptionalMemberAccess",
              "shortDescription": {
                "text": "\"mapToGlobal\" is not a known attribute of \"None\""
              }
            },
            {
              "id": "reportConstantRedefinition",
              "shortDescription": {
                "text": "\"_HAS_CFG_VIEW\" is constant (because it is uppercase) and cannot be redefined"
              }
            },
            {
              "id": "reportPossiblyUnboundVariable",
              "shortDescription": {
                "text": "\"CFGGraphView\" is possibly unbound"
              }
            },
            {
              "id": "reportUnnecessaryIsInstance",
              "shortDescription": {
                "text": "Unnecessary isinstance call; \"dict[str, object]\" is always an instance of \"dict[Unknown, Unknown]\""
              }
            }
          ]
        }
      },
