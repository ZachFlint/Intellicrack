extends: default

rules:
  line-length:
    max: 120
    level: warning
  indentation:
    spaces: 2
    indent-sequences: true
  comments:
    min-spaces-from-content: 1
  document-start: disable
  new-lines:
    type: dos
  truthy:
    allowed-values: ['true', 'false', 'yes', 'no']
    check-keys: false

ignore: |
  .pixi/
  .claude/
  .venv*/
  node_modules/
  build/
  dist/
  tools/
  vendor/
  target/
